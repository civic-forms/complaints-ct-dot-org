  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "form:dump": "node scripts/dump-form-fields.ts",
    "form:text": "node scripts/extract-form-text.ts",
    "samples": "node scripts/build-samples.ts",
    "watcher:status": "gh workflow view form-watch.yml",
    "watcher:enable": "gh workflow enable form-watch.yml && gh workflow run form-watch.yml"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.0",
    "pdfjs-dist": "^6.3.289",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
